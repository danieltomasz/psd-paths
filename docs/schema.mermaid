flowchart TD
    subgraph STEP1["STEP 1: Loading & Filtering"]
        A[Load Raw Data<br/>BIDS format<br/>MNE] --> B[Drop Channels<br/>ECG, non-EEG<br/>MNE]
        B --> C[Band-pass Filter<br/>1-40 Hz, Hamming<br/>MNE]
        C --> D[Notch Filter<br/>50 Hz, 100 Hz<br/>MNE]
        D --> E[Bad Channel Detection<br/>RANSAC, NoisyChannels<br/>PyPrep]
    end

    subgraph STEP2["STEP 2: Epoching & Artifact Detection"]
        F[Create Epochs<br/>2s, 1.5s overlap<br/>MNE] --> G[AutoReject Detection<br/>Identify bad epochs<br/>AutoReject]
        G --> H[Identify Bad Channels<br/>>40% bad epochs<br/>Custom]
        H --> I[Save Good Epochs<br/>For ICA fitting]
    end

    subgraph STEP3["STEP 3: ICA & Artifact Removal"]
        J[Compute Data Rank<br/>For ICA dimensionality] --> K[ICA Fit<br/>99% variance, max 40 components<br/>Picard → Infomax fallback]
        K --> L[Component Classification<br/>ICLabel: eye, muscle, heart, noise<br/>MNE-ICALabel]
        L --> M[ECG Component Detection<br/>Correlation method<br/>MNE]
        M --> N[Manual Override Check<br/>CSV log for manual exclusions]
        N --> O[Apply ICA<br/>Remove artifacts >80% probability]
    end

    subgraph STEP4["STEP 4: Final Processing"]
        P[AutoReject Transform<br/>Interpolate bad epochs<br/>Interpolate=1,2,4,8,32,64] --> Q[Interpolate Bad Channels<br/>Spherical splines<br/>MNE]
    end

    subgraph STEP5["STEP 5: Spectral Analysis"]
        R[Compute PSD<br/>Welch method<br/>MNE] --> S[Spectral Parameterization<br/>2-35 Hz, max 6 peaks<br/>SpecParam FOOOF]
        S --> T[Save Results<br/>CSV + Topomap plots]
    end

    E --> F
    I --> J
    O --> P
    Q --> R

    subgraph REPORT["Reporting"]
        U[MNE Report<br/>HTML generation at each step]
    end

    style STEP1 fill:#dae8fc,stroke:#6c8ebf
    style STEP2 fill:#d5e8d4,stroke:#82b366
    style STEP3 fill:#f8cecc,stroke:#b85450
    style STEP4 fill:#b0e3e6,stroke:#0e8088
    style STEP5 fill:#d0cee2,stroke:#56517e
    style REPORT fill:#f5f5f5,stroke:#666666